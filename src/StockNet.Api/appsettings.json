{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StockNet",
    "Audience": "StockNet.Api",
    "ExpirationMinutes": 60
  },
  "Stripe": {
    "ApiKey": "",
    "WebhookSecret": "",
    "PriceId": "",
    "SuccessUrl": "https://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "https://localhost:3000/billing/cancel"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "AdminEmail": "admin@stocknet.local",
    "SupplierEmail": "supplier@stocknet.local"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
